#!/usr/bin/env python3
"""Find the work already open on this machine, and write it where a role can read it.

A Cabinet role holds no shell, by design: its tool grant is what makes the money
invariant structural rather than a promise. So a role cannot look at the disk,
and work started in another worktree is invisible to it. GitHub cannot see that
work either: a workspace opened from a ticket is a local branch with nothing
pushed, so the board shows the ticket as free while somebody is a commit deep in
it.

This script is how the dispatching command closes that gap. It enumerates every
worktree of the repository on this machine, attributes each to a ticket from
evidence on disk, and writes one snapshot file that is handed to the roles the
same way the board snapshot is. Nothing is registered when a workspace opens:
the worktree existing is the claim.

Usage:   local-sessions <owner/repo> [--board <path>] [--cwd <path>]
         local-sessions --self-test
Prints:  sessions=/…/cabinet-sessions-owner-repo.json   on stdout
         a one-line count summary                       on stderr

Read-only. Exits 0 with an empty result when there is no signal to collect, so
that a missing local picture never aborts the run that asked for it.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEFAULT_STALL_HOURS = 24.0


# --------------------------------------------------------------- collection


def now() -> datetime:
    return datetime.now(timezone.utc)


def git(args: list[str], cwd: Path) -> str | None:
    """Run a read-only git command. None means it did not work, which is data."""
    try:
        done = subprocess.run(
            ["git", *args], cwd=cwd, capture_output=True, text=True, check=False
        )
    except OSError:
        return None
    if done.returncode != 0:
        return None
    return done.stdout.strip()


def normalize_remote(url: str) -> str:
    """git@github.com:acme/widget.git and https://…/acme/widget both give acme/widget."""
    trimmed = url.strip().removesuffix(".git")
    trimmed = trimmed.split(":")[-1] if trimmed.startswith("git@") else trimmed
    parts = [p for p in trimmed.replace(":", "/").split("/") if p]
    return "/".join(parts[-2:]).lower() if len(parts) >= 2 else ""


def parse_worktrees(text: str) -> list[dict]:
    """`git worktree list --porcelain` into records. Bare worktrees are skipped.

    `prunable` and `locked` are part of that format and both matter here. A
    prunable record is a worktree whose directory is gone while git's own note
    of it survives; read as an ordinary record it becomes work in flight that
    nobody can ever finish.
    """
    records: list[dict] = []
    current: dict = {}

    def blank(path: str) -> dict:
        return {"path": path, "branch": None, "bare": False,
                "prunable": None, "locked": None}

    for line in text.splitlines():
        if line.startswith("worktree "):
            if current:
                records.append(current)
            current = blank(line[len("worktree "):])
        elif line.startswith("branch "):
            current["branch"] = line[len("branch "):].removeprefix("refs/heads/")
        elif line.strip() == "bare":
            current["bare"] = True
        elif line.strip() == "detached":
            current["branch"] = None
        elif line.strip() == "prunable" or line.startswith("prunable "):
            current["prunable"] = line[len("prunable "):].strip() or "git says it can be pruned"
        elif line.strip() == "locked" or line.startswith("locked "):
            current["locked"] = line[len("locked "):].strip() or "locked, with no reason given"
    if current:
        records.append(current)
    return [r for r in records if not r["bare"]]


def default_branch(cwd: Path) -> str:
    head = git(["symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd)
    if head:
        return head.split("/", 1)[-1]
    for candidate in ("main", "master"):
        if git(["rev-parse", "--verify", f"refs/remotes/origin/{candidate}"], cwd):
            return candidate
    return "main"


def dirty_paths(worktree: Path) -> tuple[int, list[str], list[str]] | None:
    """Total dirty entries, the tracked-modified ones, and every dirty path.

    None means the read itself failed, which is not the same fact as a clean
    tree and must not be flattened into one.
    """
    porcelain = git(["status", "--porcelain"], worktree)
    if porcelain is None:
        return None
    lines = [line for line in porcelain.splitlines() if line.strip()]
    tracked: list[str] = []
    changed: list[str] = []
    for line in lines:
        code, path = line[:2], line[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        path = path.strip('"')
        changed.append(path)
        if code != "??":
            tracked.append(path)
    return len(lines), tracked, changed


def last_activity(worktree: Path, changed: list[str]) -> datetime | None:
    """The newest of the branch tip and the modification time of every dirty path.

    Untracked files count towards it. The first hour of a workspace is nothing
    but untracked files, so reading only tracked ones dates a workspace opened
    minutes ago to whenever the commit it branched from was written — which
    reads as a stall, and tells the owner to abandon work that is live. Ignored
    paths never reach `git status --porcelain` at all, so a build artefact
    cannot refresh this clock.
    """
    stamps: list[datetime] = []
    committed = git(["log", "-1", "--format=%cI"], worktree)
    if committed:
        stamps.append(datetime.fromisoformat(committed).astimezone(timezone.utc))
    for relative in changed:
        try:
            mtime = (worktree / relative).stat().st_mtime
        except OSError:
            continue
        stamps.append(datetime.fromtimestamp(mtime, timezone.utc))
    return max(stamps) if stamps else None


ATTACHMENT = re.compile(r"^github-issue-(\d+)\.md$")

# Only unambiguous shapes. A bare number anywhere in a branch name is not a
# ticket: fix/v2-parser is a parser, not ticket 2.
#
# The flag says whether the shape stands on its own. A leading number is also
# how a date and a version number start — 2026-09-09-standup, 3-0-1-hotfix,
# 20-percent-faster — so it is believed only when a board was given and has
# that issue open. Without a board it is dropped rather than trusted.
BRANCH_TICKET = [
    (re.compile(r"#(\d+)"), True),
    (re.compile(r"(?:^|[/_-])issues?[/_-]?(\d+)(?=$|[/_-])"), True),
    (re.compile(r"(?:^|[/_-])gh[/_-](\d+)(?=$|[/_-])"), True),
    (re.compile(r"^(\d+)-"), False),
]

COMMIT_TICKET = re.compile(r"#(\d+)")


def ticket_for(
    worktree: Path, branch: str | None, base: str, board_numbers: set[int] | None
) -> tuple[int | None, str, int | None]:
    """(ticket, source, rejected candidate). Evidence on disk beats a name."""
    attachments = worktree / ".superset" / "attachments"
    if attachments.is_dir():
        for entry in sorted(attachments.iterdir()):
            found = ATTACHMENT.match(entry.name)
            if found:
                # An attachment is the ticket the workspace was opened from.
                # It is not cross-checked: a ticket can close while its
                # workspace is still open, and that is exactly the state the
                # brief needs to report.
                return int(found.group(1)), "attachment", None

    def accept(candidate: int, source: str) -> tuple[int | None, str, int | None]:
        if board_numbers is not None and candidate not in board_numbers:
            return None, "none", candidate
        return candidate, source, None

    if branch:
        for pattern, stands_alone in BRANCH_TICKET:
            found = pattern.search(branch)
            if not found:
                continue
            candidate = int(found.group(1))
            if not stands_alone:
                # A date or a version that the board does not confirm was never
                # a claim on a ticket, so it is dropped rather than recorded as
                # a rejected candidate — nobody needs telling that 2026 is not
                # an open issue.
                if board_numbers is not None and candidate in board_numbers:
                    return candidate, "branch", None
                continue
            return accept(candidate, "branch")

    log = git(["log", "--format=%s%n%b", f"origin/{base}..HEAD"], worktree)
    if log:
        found = COMMIT_TICKET.search(log)
        if found:
            return accept(int(found.group(1)), "commit")

    return None, "none", None


def collect(
    repo: str,
    cwd: Path,
    board_numbers: set[int] | None,
    stall_hours: float,
    moment: datetime,
) -> dict:
    taken_at = moment.strftime("%Y-%m-%dT%H:%M:%SZ")

    def empty(reason: str) -> dict:
        return {
            "repo": repo,
            "taken_at": taken_at,
            "stall_hours": stall_hours,
            "reason": reason,
            "counts": {
                "worktrees": 0,
                "in_flight": 0,
                "attributed": 0,
                "stalled": 0,
                "prunable": 0,
                "unreadable": 0,
            },
            "worktrees": [],
        }

    toplevel = git(["rev-parse", "--show-toplevel"], cwd)
    if not toplevel:
        return empty("not inside a git repository, so no local work could be seen")

    origin = git(["remote", "get-url", "origin"], cwd)
    if not origin or normalize_remote(origin) != repo.lower():
        return empty(f"this checkout's origin is not {repo}, so no local work was collected")

    listing = git(["worktree", "list", "--porcelain"], cwd)
    if listing is None:
        return empty("git could not list worktrees, so no local work was collected")

    base = default_branch(cwd)
    here = Path(toplevel).resolve()
    worktrees: list[dict] = []

    for record in parse_worktrees(listing):
        path = Path(record["path"])
        branch = record["branch"]
        ticket, ticket_source, rejected = ticket_for(path, branch, base, board_numbers)
        entry = {
            "path": str(path),
            "branch": branch,
            "is_current": path.resolve() == here,
            "kind": "workspace",
            "in_flight": False,
            "reason": None,
            "locked": record["locked"],
            "ticket": ticket,
            "ticket_source": ticket_source,
            "rejected_ticket": rejected,
            "commits_ahead": None,
            "unpushed": None,
            "dirty": None,
            "last_activity": None,
            "idle_hours": None,
            "stalled": False,
        }

        if record["prunable"]:
            # The directory is gone and only git's note of it survives. Calling
            # that work in flight takes its ticket off the frontier for good:
            # with no directory there is no activity, so it can never age into
            # a stall and clear itself.
            entry["kind"] = "prunable"
            entry["reason"] = f"the workspace directory is gone — {record['prunable']}"
            worktrees.append(entry)
            continue

        status = dirty_paths(path)
        head = git(["log", "-1", "--format=%cI"], path)
        if status is None and head is None:
            # Neither read that identifies a worktree answered, so there is
            # nothing here to describe. Coercing that to zero would make it
            # indistinguishable from a clean tree, and telling those two apart
            # is the whole reason this scan exists.
            entry["kind"] = "unreadable"
            entry["reason"] = "this workspace could not be read, so what it holds is unknown"
            worktrees.append(entry)
            continue

        dirty, _tracked, changed = status if status is not None else (None, [], [])

        # The comparison against the default branch is the one read that can
        # fail on a perfectly healthy worktree: origin/HEAD may be unset and the
        # default branch may be called something other than main or master. That
        # makes one number unknown, not the whole record — the dirty count and
        # the activity clock never depended on it. Going blind on a repository
        # over a naming convention would put back the same failure as a zero.
        ahead_raw = git(["rev-list", "--count", f"origin/{base}..HEAD"], path)
        ahead = int(ahead_raw) if ahead_raw and ahead_raw.isdigit() else None
        unpushed_raw = git(["rev-list", "--count", "HEAD", "--not", "--remotes"], path)
        unpushed = int(unpushed_raw) if unpushed_raw and unpushed_raw.isdigit() else None
        activity = last_activity(path, changed)
        idle_hours = (
            round((moment - activity).total_seconds() / 3600.0, 1) if activity else None
        )
        if ahead is None:
            entry["reason"] = (
                f"how far ahead of origin/{base} this workspace is could not be "
                "worked out; what it holds was still read"
            )
        elif dirty is None:
            entry["reason"] = "what this workspace has uncommitted could not be read"

        # A clean tree with nothing ahead of the default branch is being looked
        # at, not worked on. That includes a detached HEAD: someone bisecting,
        # reading an old commit or inspecting a tag is not working a ticket.
        #
        # With no base to compare against, unpushed commits answer the same
        # question: they are the local work GitHub cannot see, which is what
        # this whole scan is for. What is never allowed is calling a worktree
        # idle because a number came back unknown.
        local_work = ahead if ahead is not None else unpushed
        is_checkout = dirty == 0 and local_work == 0 and branch in (base, None)
        entry.update(
            {
                "kind": "checkout" if is_checkout else "workspace",
                "in_flight": not is_checkout,
                "commits_ahead": ahead,
                "unpushed": unpushed,
                "dirty": dirty,
                "last_activity": activity.strftime("%Y-%m-%dT%H:%M:%SZ") if activity else None,
                "idle_hours": idle_hours,
                "stalled": bool(
                    (not is_checkout) and idle_hours is not None and idle_hours >= stall_hours
                ),
            }
        )
        worktrees.append(entry)

    in_flight = [w for w in worktrees if w["in_flight"]]
    return {
        "repo": repo,
        "taken_at": taken_at,
        "stall_hours": stall_hours,
        "counts": {
            "worktrees": len(worktrees),
            "in_flight": len(in_flight),
            "attributed": len([w for w in in_flight if w["ticket"] is not None]),
            "stalled": len([w for w in worktrees if w["stalled"]]),
            "prunable": len([w for w in worktrees if w["kind"] == "prunable"]),
            "unreadable": len([w for w in worktrees if w["kind"] == "unreadable"]),
        },
        "worktrees": worktrees,
    }


# ----------------------------------------------------------------- self-test


def run(args: list[str], cwd: Path, env: dict[str, str] | None = None) -> None:
    subprocess.run(
        args,
        cwd=cwd,
        check=True,
        capture_output=True,
        env={**os.environ, **env} if env else None,
    )


def build_fixture(base: Path) -> Path:
    """A repository with a main checkout and several worktrees."""
    origin = base / "origin.git"
    run(["git", "init", "--bare", "-b", "main", str(origin)], base)

    main = base / "main"
    run(["git", "clone", str(origin), str(main)], base)
    run(["git", "config", "user.email", "t@example.com"], main)
    run(["git", "config", "user.name", "T"], main)
    # A clone of an empty bare repository leaves HEAD on whatever
    # init.defaultBranch happens to be locally. Pin it.
    run(["git", "symbolic-ref", "HEAD", "refs/heads/main"], main)
    (main / "README.md").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], main)
    run(["git", "commit", "-m", "init"], main)
    # Push while origin is still the path, so refs/remotes/origin/main exists,
    # and only then make the remote look like the real thing.
    run(["git", "push", "-u", "origin", "main"], main)
    run(["git", "remote", "set-url", "origin", "git@github.com:acme/widget.git"], main)

    # A worktree with committed and uncommitted work.
    busy = base / "busy"
    run(["git", "worktree", "add", "-b", "feat/shared-writers", str(busy)], main)
    (busy / "a.txt").write_text("one\n", encoding="utf-8")
    run(["git", "add", "-A"], busy)
    run(["git", "commit", "-m", "work"], busy)
    (busy / "a.txt").write_text("two\n", encoding="utf-8")

    attach = busy / ".superset" / "attachments"
    attach.mkdir(parents=True)
    (attach / "github-issue-179.md").write_text("body\n", encoding="utf-8")

    # A branch whose name carries a version, not a ticket.
    trap = base / "trap"
    run(["git", "worktree", "add", "-b", "fix/v2-parser", str(trap)], main)
    (trap / "b.txt").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], trap)
    run(["git", "commit", "-m", "parser fix"], trap)

    # A branch whose name does carry a ticket, for the board cross-check.
    named = base / "named"
    run(["git", "worktree", "add", "-b", "issue-4242-cleanup", str(named)], main)
    (named / "c.txt").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], named)
    run(["git", "commit", "-m", "cleanup"], named)

    # A branch that starts with a number which is a date, not a ticket.
    dated = base / "dated"
    run(["git", "worktree", "add", "-b", "2026-09-09-cabinet-standup", str(dated)], main)
    (dated / "f.txt").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], dated)
    run(["git", "commit", "-m", "standup work"], dated)

    # A workspace whose only sign of life is a file git does not track yet,
    # sitting on a branch whose newest commit is ten days old. This is what the
    # first hour of any new workspace looks like.
    stale_stamp = (now() - timedelta(days=10)).strftime("%Y-%m-%dT%H:%M:%SZ")
    fresh = base / "fresh"
    run(["git", "worktree", "add", "-b", "feat/untracked-only", str(fresh)], main)
    (fresh / "d.txt").write_text("committed\n", encoding="utf-8")
    run(["git", "add", "-A"], fresh)
    run(
        ["git", "commit", "-m", "an old commit"],
        fresh,
        {"GIT_AUTHOR_DATE": stale_stamp, "GIT_COMMITTER_DATE": stale_stamp},
    )
    (fresh / "scratch.txt").write_text("written just now\n", encoding="utf-8")

    # A worktree deleted with rm rather than `git worktree remove`, which is
    # how most of them die. Git keeps its own note of it and marks it prunable.
    ghost = base / "ghost"
    run(["git", "worktree", "add", "-b", "issue-9001-gone", str(ghost)], main)
    (ghost / "e.txt").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], ghost)
    run(["git", "commit", "-m", "work that is about to vanish"], ghost)
    shutil.rmtree(ghost)

    # A detached HEAD sitting on the default tip: bisecting, or reading a tag.
    run(["git", "worktree", "add", "--detach", str(base / "detached"), "origin/main"], main)

    # A worktree git still lists, and still does not call prunable, but can no
    # longer read: the file pointing back at the repository says nowhere. Both
    # of the reads that identify a worktree fail here.
    broken = base / "broken"
    run(["git", "worktree", "add", "-b", "feat/broken-identity", str(broken)], main)
    (broken / ".git").write_text("gitdir: /nowhere-at-all\n", encoding="utf-8")

    # The main checkout itself is the clean-default-branch case.
    return main


def build_unpushed_fixture(base: Path) -> Path:
    """A clone whose default branch has never been pushed.

    Nothing exists under `refs/remotes/origin`, so the one comparison that needs
    a base cannot run — while `git status` answers perfectly well and says there
    is a file changed and not committed. This is also what a repository whose
    default branch is called `develop` looks like when `origin/HEAD` is unset,
    and going blind on all of it over that would be the same failure as a zero.
    """
    origin = base / "unpushed.git"
    run(["git", "init", "--bare", "-b", "main", str(origin)], base)

    local = base / "unpushed"
    run(["git", "clone", str(origin), str(local)], base)
    run(["git", "config", "user.email", "t@example.com"], local)
    run(["git", "config", "user.name", "T"], local)
    run(["git", "symbolic-ref", "HEAD", "refs/heads/main"], local)
    (local / "README.md").write_text("x\n", encoding="utf-8")
    run(["git", "add", "-A"], local)
    run(["git", "commit", "-m", "init"], local)
    run(["git", "remote", "set-url", "origin", "git@github.com:acme/widget.git"], local)
    (local / "README.md").write_text("edited, not committed\n", encoding="utf-8")
    return local


def self_test() -> int:
    problems: list[str] = []

    def expect(condition: bool, description: str) -> None:
        if not condition:
            problems.append(description)

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        main = build_fixture(base)

        result = collect("acme/widget", main, None, DEFAULT_STALL_HOURS, now())
        by_branch = {w["branch"]: w for w in result["worktrees"]}
        by_name = {Path(w["path"]).name: w for w in result["worktrees"]}

        expect(result["counts"]["worktrees"] == 9,
               f"expected 9 worktrees, got {result['counts']['worktrees']}")
        expect("feat/shared-writers" in by_branch,
               f"branches found: {sorted(str(b) for b in by_branch)}")

        busy = by_branch.get("feat/shared-writers", {})
        expect(busy.get("commits_ahead") == 1,
               f"expected 1 commit ahead, got {busy.get('commits_ahead')}")
        expect(busy.get("unpushed") == 1,
               f"expected 1 unpushed commit, got {busy.get('unpushed')}")
        # The attachment directory added in this worktree is itself an
        # untracked entry, alongside the one modified tracked file.
        expect(busy.get("dirty") == 2,
               f"expected 2 dirty entries, got {busy.get('dirty')}")
        expect(busy.get("in_flight") is True, "a worktree with work is in flight")
        expect(busy.get("kind") == "workspace",
               f"expected kind workspace, got {busy.get('kind')}")

        checkout = by_branch.get("main", {})
        expect(checkout.get("kind") == "checkout",
               "a clean worktree on the default branch is a checkout, not a session")
        expect(checkout.get("in_flight") is False,
               "a clean default-branch checkout is not work in flight")

        expect(busy.get("ticket") == 179,
               f"attachment must win attribution, got {busy.get('ticket')}")
        expect(busy.get("ticket_source") == "attachment",
               f"expected source attachment, got {busy.get('ticket_source')}")

        trap = by_branch.get("fix/v2-parser", {})
        expect(trap.get("ticket") is None,
               f"a version in a branch name is not a ticket, got {trap.get('ticket')}")
        expect(trap.get("ticket_source") == "none",
               f"expected source none, got {trap.get('ticket_source')}")

        named = by_branch.get("issue-4242-cleanup", {})
        expect(named.get("ticket") == 4242,
               f"issue-<n> in a branch name is a ticket, got {named.get('ticket')}")

        # A workspace whose only activity is untracked. The clock has to read
        # the untracked file, not the ten-day-old commit it branched from.
        fresh = by_branch.get("feat/untracked-only", {})
        expect(fresh.get("dirty") == 1,
               f"expected 1 dirty entry, got {fresh.get('dirty')}")
        expect(fresh.get("idle_hours") is not None and fresh["idle_hours"] < 1.0,
               f"an untracked file written now is activity, got idle_hours "
               f"{fresh.get('idle_hours')}")
        expect(fresh.get("stalled") is False,
               "a workspace touched seconds ago is not stalled")

        # A worktree deleted with rm: git still lists it, and it must not be
        # reported as somebody's work in flight.
        ghost = by_name.get("ghost", {})
        expect(ghost.get("kind") == "prunable",
               f"a deleted worktree is prunable, got kind {ghost.get('kind')}")
        expect(ghost.get("in_flight") is False,
               "a worktree whose directory is gone is not work in flight")
        expect(bool(ghost.get("reason")),
               "a prunable worktree must carry the reason it is prunable")
        expect(result["counts"]["prunable"] == 1,
               f"expected 1 prunable worktree, got {result['counts'].get('prunable')}")

        # A detached HEAD on the default tip, clean: someone reading, not working.
        detached = by_name.get("detached", {})
        expect(detached.get("branch") is None,
               f"the detached fixture must have no branch, got {detached.get('branch')}")
        expect(detached.get("kind") == "checkout",
               f"a clean detached worktree is a checkout, got {detached.get('kind')}")
        expect(detached.get("in_flight") is False,
               "a clean detached worktree is not work in flight")

        # A worktree git still lists but can no longer read at all. This is the
        # state that must never come back looking like a clean tree.
        broken = by_name.get("broken", {})
        expect(broken.get("kind") == "unreadable",
               f"a worktree that could not be read is unreadable, got {broken.get('kind')}")
        expect(broken.get("in_flight") is False,
               "a worktree that could not be read is not reported as work in flight")
        expect(broken.get("dirty") is None and broken.get("commits_ahead") is None,
               f"a failed read must not become a zero, got dirty {broken.get('dirty')} "
               f"and {broken.get('commits_ahead')} ahead")
        expect(bool(broken.get("reason")),
               "a worktree that could not be read must carry its own reason")
        expect(result["counts"]["unreadable"] == 1,
               f"expected 1 unreadable worktree, got {result['counts'].get('unreadable')}")

        expect(result["counts"]["in_flight"] == 5,
               f"expected 5 in flight, got {result['counts']['in_flight']}")

        # A leading number with no board behind it is a date or a version as
        # often as it is a ticket, so with no board it is not a ticket at all.
        dated = by_branch.get("2026-09-09-cabinet-standup", {})
        expect(dated.get("ticket") is None,
               f"a date leading a branch name is not a ticket, got {dated.get('ticket')}")
        expect(dated.get("rejected_ticket") is None,
               f"a date is not a rejected ticket candidate either, got "
               f"{dated.get('rejected_ticket')}")

        checked = collect("acme/widget", main, {179}, DEFAULT_STALL_HOURS, now())
        checked_by_branch = {w["branch"]: w for w in checked["worktrees"]}
        rejected = checked_by_branch.get("issue-4242-cleanup", {})
        expect(rejected.get("ticket") is None,
               "a branch-derived number absent from the board must be rejected")
        expect(rejected.get("rejected_ticket") == 4242,
               f"the rejected candidate must be recorded, got {rejected.get('rejected_ticket')}")
        expect(checked_by_branch.get("2026-09-09-cabinet-standup", {}).get("ticket") is None,
               "a board without that number does not rescue a leading number")
        expect(checked["counts"]["attributed"] == 1,
               f"expected 1 attributed worktree, got {checked['counts']['attributed']}")

        confirmed = collect("acme/widget", main, {179, 2026}, DEFAULT_STALL_HOURS, now())
        confirmed_by_branch = {w["branch"]: w for w in confirmed["worktrees"]}
        leading = confirmed_by_branch.get("2026-09-09-cabinet-standup", {})
        expect(leading.get("ticket") == 2026,
               f"a board that has the number open accepts it, got {leading.get('ticket')}")
        expect(leading.get("ticket_source") == "branch",
               f"expected source branch, got {leading.get('ticket_source')}")

        stale = collect("acme/widget", main, None, 0.0, now())
        expect(all(w["stalled"] for w in stale["worktrees"] if w["in_flight"]),
               "a zero-hour threshold must mark every in-flight worktree stalled")

        outside = base / "not-a-repo"
        outside.mkdir()
        empty = collect("acme/widget", outside, None, DEFAULT_STALL_HOURS, now())
        expect(empty["counts"]["worktrees"] == 0,
               "outside a git repository the result must be empty")
        expect("reason" in empty, "an empty result must say why it is empty")

        wrong = collect("acme/other", main, None, DEFAULT_STALL_HOURS, now())
        expect(wrong["counts"]["worktrees"] == 0,
               "a repository whose origin does not match must produce an empty result")

        # A base that cannot be resolved costs one number, not the whole
        # record. Everything else here was read, and dirty files are work in
        # flight whether or not anything can say how far ahead they are.
        unpushed = build_unpushed_fixture(base)
        blind = collect("acme/widget", unpushed, None, DEFAULT_STALL_HOURS, now())
        record = blind["worktrees"][0] if blind["worktrees"] else {}
        expect(record.get("kind") == "workspace",
               f"an unresolvable base does not make a worktree unreadable, got "
               f"{record.get('kind')}")
        expect(record.get("commits_ahead") is None,
               f"an ahead count that could not be worked out is unknown, not zero, "
               f"got {record.get('commits_ahead')}")
        expect(record.get("dirty") == 1,
               f"the dirty count does not need a base, got {record.get('dirty')}")
        expect(record.get("in_flight") is True,
               "a dirty worktree is in flight whether or not it can be compared to a base")
        expect(bool(record.get("reason")),
               "a record missing a number must say which number and why")
        expect(blind["counts"]["unreadable"] == 0,
               f"an unresolvable base is not an unreadable worktree, got "
               f"{blind['counts'].get('unreadable')}")

    if problems:
        print("local-sessions self-test FAILED:\n")
        for problem in problems:
            print(f"  - {problem}")
        return 1
    print("local-sessions self-test passed.")
    return 0


def summary_line(result: dict) -> str:
    counts = result["counts"]
    if "reason" in result:
        return f"Local: no signal — {result['reason']}"
    detail = ""
    named = [w for w in result["worktrees"] if w["in_flight"] and w["ticket"]]
    if named:
        parts = [
            f"#{w['ticket']}"
            + (f", {w['idle_hours']:.0f}h" if w["idle_hours"] is not None else "")
            for w in named
        ]
        detail = f" ({'; '.join(parts)})"
    # Neither of these belongs on the line when it is zero; both belong on it
    # when it is not, because each is something the owner has to be told rather
    # than left to read as a clean tree.
    trailing = ""
    if counts.get("prunable"):
        trailing += f" · {counts['prunable']} gone"
    if counts.get("unreadable"):
        trailing += f" · {counts['unreadable']} unreadable"
    return (
        f"Local: {counts['worktrees']} worktrees · "
        f"{counts['in_flight']} in flight{detail} · {counts['stalled']} stalled{trailing}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("repo", nargs="?")
    parser.add_argument("--board")
    parser.add_argument("--cwd")
    parser.add_argument("--self-test", action="store_true", dest="self_test")
    args = parser.parse_args()

    if args.self_test:
        return self_test()

    if not args.repo or "/" not in args.repo:
        print("usage: local-sessions <owner/repo> [--board <path>]", file=sys.stderr)
        return 64

    stall_hours = DEFAULT_STALL_HOURS
    override = os.environ.get("CABINET_STALL_HOURS")
    if override:
        try:
            stall_hours = float(override)
        except ValueError:
            print(
                f"local-sessions: CABINET_STALL_HOURS is not a number ('{override}'); "
                f"using {DEFAULT_STALL_HOURS}",
                file=sys.stderr,
            )

    cwd = Path(args.cwd) if args.cwd else Path.cwd()

    board_numbers: set[int] | None = None
    if args.board:
        try:
            board = json.loads(Path(args.board).read_text(encoding="utf-8"))
            board_numbers = {int(issue["number"]) for issue in board.get("open_issues", [])}
        except (OSError, ValueError, KeyError, TypeError):
            print(
                f"local-sessions: could not read the board at {args.board}; "
                "ticket numbers from branch names and commits are reported unverified",
                file=sys.stderr,
            )

    result = collect(args.repo, cwd, board_numbers, stall_hours, now())

    slug = args.repo.replace("/", "-")
    out = Path(os.environ.get("TMPDIR", "/tmp")) / f"cabinet-sessions-{slug}.json"
    out.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")

    print(summary_line(result), file=sys.stderr)
    print(f"sessions={out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
