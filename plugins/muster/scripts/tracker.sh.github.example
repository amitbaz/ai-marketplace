#!/usr/bin/env bash
# Reference tracker.sh implementation for GitHub Issues + Pull Requests.
#
# This script IS the tracker contract, and the plugin's roles are granted
# exactly `Bash(.claude/coordination-state/tracker.sh *)` and nothing else —
# so this file is the whole read-only security boundary for every role.
# Keep it small enough that someone deciding whether to install the plugin
# can read it in one sitting.
#
# Install: copy to .claude/coordination-state/tracker.sh in the target repo
# and `chmod +x` it. A different forge (GitLab, Linear, Jira, ...) needs a
# new script implementing the same commands below — nothing in agents/*.md
# or skills/*/SKILL.md changes.
#
# In-progress convention (see STATE_FILE_SPEC.md): this reference
# implementation treats the label "in-progress" as the confirmation signal,
# distinct from "assigned". Apply that label by hand, or have your own
# dispatch flow apply it, only once an agent has actually confirmed it is
# working the ticket — not at assignment time. If your repo doesn't use
# that convention, `in-progress` below always reports "unsupported" until
# you adapt it, and callers fall back to unblocked-and-unassigned.

set -euo pipefail

fail() {
  echo "tracker.sh error: $1" >&2
  exit 1
}

require_gh() {
  command -v gh >/dev/null 2>&1 || fail "gh CLI not found. Install: https://cli.github.com/. Nothing below will work without it."
  gh auth status >/dev/null 2>&1 || fail "gh is installed but not authenticated. Run: gh auth login"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  list-tickets)
    require_gh
    # id, title, state, labels — blocking/blocked-by edges come from GitHub's
    # native issue links where available; gh's REST surface for these is
    # limited, so this reports labels only. See the plugin's README for the
    # known gap and the manual workaround (a "blocked-by:#N" label convention).
    gh issue list --state open --json number,title,state,labels \
      --jq '.[] | {id: .number, title: .title, state: .state, labels: [.labels[].name]}'
    ;;

  get-ticket)
    id="${1:-}"
    [ -n "$id" ] || fail "get-ticket requires an id: tracker.sh get-ticket <id>"
    require_gh
    gh issue view "$id" --json number,title,state,body,labels,assignees \
      --jq '{id: .number, title: .title, state: .state, body: .body, labels: [.labels[].name], assignees: [.assignees[].login]}'
    ;;

  list-prs)
    require_gh
    gh pr list --state open --json number,title,statusCheckRollup,isDraft \
      --jq '.[] | {id: .number, title: .title, draft: .isDraft, checks: ([.statusCheckRollup[]?.conclusion // "pending"] | unique)}'
    ;;

  in-progress)
    # This reference implementation always supports the concept — it's a
    # label check — so it never returns "unsupported". A tracker.sh for a
    # forge with no equivalent label/field should return "unsupported" and
    # let the calling role fall back, per STATE_FILE_SPEC.md.
    id="${1:-}"
    [ -n "$id" ] || fail "in-progress requires an id: tracker.sh in-progress <id>"
    require_gh
    labels=$(gh issue view "$id" --json labels --jq '[.labels[].name] | join(",")' 2>/dev/null) || fail "could not read issue #$id"
    if [[ ",$labels," == *",in-progress,"* ]]; then
      echo "true"
    else
      echo "false"
    fi
    ;;

  *)
    fail "unknown command '$cmd'. Supported: list-tickets, get-ticket <id>, list-prs, in-progress <id>"
    ;;
esac
